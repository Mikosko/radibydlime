---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import botanicalStem from '../../assets/decor/botanical-stem.png';
import floralDivider from '../../assets/decor/floral-divider.png';
import hopDivider from '../../assets/decor/hop-divider.png';
import gardenPhoto from '../../assets/editorial/sample-kitchen-garden.webp';
import restorationPhoto from '../../assets/editorial/sample-restoration-hero.webp';
import timberPhoto from '../../assets/editorial/sample-timber-joint.webp';
import houseLandscape from '../../assets/images/center-image.png';
import ArticleActions from '../../components/article-actions/ArticleActions.astro';
import ArticleGallery from '../../components/article-gallery/ArticleGallery.astro';
import AuthorCard from '../../components/author-card/AuthorCard.astro';
import FigureCaption from '../../components/figure-caption/FigureCaption.astro';
import MediaImage from '../../components/media-image/MediaImage.astro';
import { getMediaCatalog } from '../../content/media/query';
import { getPublishedProjects } from '../../content/projects/query';
import SiteLayout from '../../layouts/site/SiteLayout.astro';

export async function getStaticPaths() {
  const catalog = await getMediaCatalog();
  const projects = await getPublishedProjects(catalog);
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      catalog,
      newerProject: projects[index - 1] ?? null,
      olderProject: projects[index + 1] ?? null,
    },
  }));
}

type PublishedProject = Awaited<
  ReturnType<typeof getPublishedProjects>
>[number];

interface Props {
  catalog: Awaited<ReturnType<typeof getMediaCatalog>>;
  project: PublishedProject;
  newerProject: PublishedProject | null;
  olderProject: PublishedProject | null;
}

const { project, catalog, newerProject, olderProject } = Astro.props;
const { data, hero, author, gallery } = project;
const { Content, headings } = await render(project);
const articleHeadings = headings.filter(({ depth }) => depth === 2);
const formattedDate = data.publishedAt.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<SiteLayout title={data.title} description={data.summary}>
  <div class="py-7 sm:py-10">
    <a
      href="/kapitoly/"
      class="inline-flex items-center gap-3 py-2 text-xs tracking-[0.12em] text-muted uppercase hover:text-accent xl:hidden"
    >
      <span aria-hidden="true">←</span> na projekty
    </a>

    <div class="mt-5 grid grid-cols-[minmax(0,1fr)] gap-x-8 gap-y-12 xl:grid-cols-[18rem_minmax(0,1fr)_22rem] 2xl:grid-cols-[13rem_minmax(0,1fr)_24rem]">
      <article class="min-w-0 xl:col-start-2 xl:row-start-1 pt-1.75">
        <header>
          <p class="font-editorial-note text-xs tracking-[0.12em] text-muted uppercase">
            <span class="text-accent">Kapitoly</span>
            <span class="px-2" aria-hidden="true">
              ·
            </span>
            {data.topic}
            <span class="px-2" aria-hidden="true">
              /
            </span>
            <time datetime={data.publishedAt.toISOString()}>
              {formattedDate}
            </time>
          </p>
          <h1 class="mt-4 max-w-4xl font-display text-5xl font-semibold leading-[0.98] tracking-[-0.025em] sm:text-6xl lg:text-6xl">
            {data.title}
          </h1>
          <p class="mt-5 max-w-4xl text-xl leading-relaxed text-muted sm:text-2xl">
            {data.summary}
          </p>
        </header>

        <figure class="relative mt-7">
          {'width' in hero ? (
            <MediaImage
              mediaId={hero.id}
              catalog={catalog}
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/8.5] w-full bg-line object-cover"
            />
          ) : (
            <Image
              src={hero.src}
              alt={hero.alt}
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/8.5] w-full bg-line object-cover"
            />
          )}
          <p
            class="absolute top-5 right-5 max-w-44 -rotate-3 text-right font-annotation text-2xl leading-tight text-paper drop-shadow-sm sm:top-8 sm:right-8 sm:text-3xl"
            aria-hidden="true"
          >
            Dům roste s námi.
          </p>
          <FigureCaption caption={hero.caption} credit={hero.credit} />
        </figure>

        <div class="narrative article-narrative mt-8">
          <Content />
        </div>

        <Image
          src={floralDivider}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="mx-auto mt-10 h-auto w-full max-w-50 opacity-85"
        />

        <ArticleGallery items={gallery} catalog={catalog} />

        {(newerProject || olderProject) && (
          <nav
            aria-label="Další projekty"
            class="relative mt-14 border-y border-line py-7"
          >
            <p class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-paper px-5 font-editorial-note text-[0.65rem] tracking-[0.14em] text-muted uppercase">
              Pokračujte ve čtení
            </p>
            <div class="grid gap-7 sm:grid-cols-2 sm:gap-10">
              {newerProject && (
                <a
                  href={`/projekty/${newerProject.data.slug}/`}
                  class="group block py-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="text-xs font-semibold tracking-[0.1em] text-accent uppercase">
                    <span aria-hidden="true">←</span> Novější projekt
                  </span>
                  <span class="mt-2 block font-display text-2xl leading-tight group-hover:underline">
                    {newerProject.data.title}
                  </span>
                </a>
              )}
              {olderProject && (
                <a
                  href={`/projekty/${olderProject.data.slug}/`}
                  class="group block py-2 sm:col-start-2 sm:text-right focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="text-xs font-semibold tracking-[0.1em] text-accent uppercase">
                    Starší projekt <span aria-hidden="true">→</span>
                  </span>
                  <span class="mt-2 block font-display text-2xl leading-tight group-hover:underline">
                    {olderProject.data.title}
                  </span>
                </a>
              )}
            </div>
          </nav>
        )}
      </article>

      <aside
        class="hidden min-w-0 border-line xl:col-start-1 xl:row-start-1 xl:block xl:border-r xl:pr-6"
        aria-labelledby="obsah-clanku-nadpis"
      >
        <div class="sticky top-8">
          <a
            href="/kapitoly/"
            class="inline-flex w-full items-center gap-3 border-line pb-5 text-xs tracking-[0.12em] text-muted uppercase hover:text-accent"
          >
            <span aria-hidden="true">←</span> Zpět na Kapitoly
          </a>

          <h2
            id="obsah-clanku-nadpis"
            class="mt-7 font-editorial-note text-xs tracking-[0.14em] uppercase"
          >
            V článku
          </h2>

          {articleHeadings.length > 0 && (
            <nav aria-label="Obsah článku">
              <ol class="mt-4 divide-y divide-line border-y border-line">
                {articleHeadings.map(({ slug, text }, index) => (
                  <li>
                    <a
                      href={`#${slug}`}
                      class="group grid grid-cols-[1.6rem_1fr] gap-2 py-4 text-sm leading-snug text-muted hover:text-ink"
                    >
                      <span
                        class="font-editorial-note text-[0.65rem] text-accent"
                        aria-hidden="true"
                      >
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="group-hover:underline">{text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          {data.sidebarPoster && (
            <figure class="mt-10 border-b border-line pb-8 text-center">
              <Image
                src={data.sidebarPoster.illustration}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="mx-auto max-h-28 w-auto max-w-full opacity-75"
              />
              <figcaption class="mt-5">
                <p class="font-editorial-note text-[0.65rem] tracking-[0.12em] text-muted uppercase">
                  Poznámka z domu
                </p>
                <blockquote class="mt-3 font-display text-xl leading-snug italic">
                  „{data.sidebarPoster.quote}“
                </blockquote>
              </figcaption>
            </figure>
          )}
        </div>
      </aside>

      <aside
        class="min-w-0 space-y-5 xl:col-start-3 xl:row-start-1"
        aria-label="Informace k článku"
      >
        <ArticleActions articleId={data.id} title={data.title} />

        <AuthorCard author={author} />

        <section class="border border-line bg-white/20 p-6">
          <h2 class="font-editorial-note text-xs tracking-[0.14em] uppercase">
            Související články
          </h2>
          <div class="mt-5 space-y-4">
            <article class="grid grid-cols-[6.5rem_1fr] items-center gap-4">
              <Image
                src={timberPhoto}
                alt="Detail ruční opravy dřevěného spoje."
                loading="lazy"
                class="aspect-[4/3] w-full object-cover"
              />
              <div>
                <h3 class="font-display text-lg leading-tight">
                  Tradiční dřevěné spoje, které vydrží
                </h3>
                <p class="mt-2 text-[0.65rem] tracking-[0.12em] text-muted uppercase">
                  2. března 2024
                </p>
              </div>
            </article>
            <article class="grid grid-cols-[6.5rem_1fr] items-center gap-4">
              <Image
                src={gardenPhoto}
                alt="Zeleninová zahrada u starého venkovského domu."
                loading="lazy"
                class="aspect-[4/3] w-full object-cover"
              />
              <div>
                <h3 class="font-display text-lg leading-tight">
                  Pěstování chmele na malém pozemku
                </h3>
                <p class="mt-2 text-[0.65rem] tracking-[0.12em] text-muted uppercase">
                  18. srpna 2023
                </p>
              </div>
            </article>
            <article class="grid grid-cols-[6.5rem_1fr] items-center gap-4">
              <Image
                src={restorationPhoto}
                alt="Starý venkovský dům během citlivé obnovy."
                loading="lazy"
                class="aspect-[4/3] w-full object-cover"
              />
              <div>
                <h3 class="font-display text-lg leading-tight">
                  Kamenné základy krok za krokem
                </h3>
                <p class="mt-2 text-[0.65rem] tracking-[0.12em] text-muted uppercase">
                  12. ledna 2023
                </p>
              </div>
            </article>
          </div>
        </section>

        <Image
          src={hopDivider}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="mx-auto h-auto w-full max-w-xs opacity-80"
        />

        <section
          class="relative overflow-hidden border border-line bg-white/20 p-6"
          aria-labelledby="pridejte-se"
        >
          <div class="max-w-48">
            <h2 id="pridejte-se" class="font-display text-3xl leading-tight">
              Přidejte se k naší komunitě
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Nové články, sezónní tipy a příběhy přímo do vaší schránky.
            </p>
          </div>
          <Image
            src={botanicalStem}
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="pointer-events-none absolute top-4 right-3 h-auto w-16 opacity-55"
          />

          <form class="mt-5" aria-describedby="odber-stav">
            <label for="odber-email" class="sr-only">
              Váš e-mail
            </label>
            <input
              id="odber-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="Váš e-mail"
              class="w-full border border-line bg-paper/70 px-4 py-3 text-base outline-none placeholder:text-muted/70 focus:border-accent focus:ring-1 focus:ring-accent"
            />
            <button
              type="submit"
              disabled
              class="mt-2 w-full cursor-not-allowed bg-ink px-4 py-3 text-center text-xs font-semibold tracking-[0.12em] text-paper uppercase opacity-80"
            >
              Přihlásit se <span aria-hidden="true">→</span>
            </button>
            <p id="odber-stav" class="mt-2 text-xs text-muted">
              Přihlášení k odběru právě připravujeme.
            </p>
          </form>

          <!-- <div class="mt-6 grid grid-cols-[1.15fr_1fr] items-end gap-3 border-t border-line pt-5">
            <Image
              src={houseLandscape}
              alt=""
              aria-hidden="true"
              width={180}
              loading="lazy"
              class="h-auto w-full opacity-75"
            />
            <p class="-rotate-2 font-annotation text-xl leading-tight text-accent">
              Společně tvoříme krásnější místo k životu.
            </p>
          </div> -->
        </section>
        <Image
          src={houseLandscape}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="h-auto w-full opacity-75"
        />
      </aside>
    </div>
  </div>
</SiteLayout>
