---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { getPublishedProjects } from '../../content/projects/query';
import SiteLayout from '../../layouts/site/SiteLayout.astro';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<SiteLayout title={data.title} description={data.summary}>
  <article class="pt-10 sm:pt-16">
    <a
      href="/#projekty"
      class="inline-flex items-center gap-3 py-2 text-sm text-muted hover:underline"
    >
      <span aria-hidden="true">←</span> Všechny projekty
    </a>
    <header class="max-w-3xl py-8 sm:py-12">
      <p class="mb-5 text-xs font-semibold tracking-widest text-accent uppercase">
        Z našich projektů
      </p>
      <h1 class="font-display text-4xl leading-tight tracking-tight sm:text-6xl">
        {data.title}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted sm:text-xl">
        {data.summary}
      </p>
      <p class="mt-6 text-sm text-muted">
        <time datetime={data.publishedAt.toISOString()}>
          {data.publishedAt.toLocaleDateString('cs-CZ', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </p>
    </header>
    <figure>
      <Image
        src={data.hero.src}
        alt={data.hero.alt}
        loading="eager"
        class="max-h-144 w-full rounded-sm object-cover"
      />
      {(data.hero.caption || data.hero.credit) && (
        <figcaption class="mt-3 text-sm text-muted">
          {data.hero.caption}
          {data.hero.credit && <span> Autor: {data.hero.credit}</span>}
        </figcaption>
      )}
    </figure>
    <div class="narrative mx-auto mt-12 max-w-prose sm:mt-16">
      <Content />
    </div>
  </article>
</SiteLayout>
