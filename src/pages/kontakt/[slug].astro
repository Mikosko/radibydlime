---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/site/SiteLayout.astro';
import BrandMark from '../../components/brand-mark/BrandMark.astro';
import craft from '../../assets/decor/business-card-craft.png';
import { getContacts } from '../../content/contacts/query';

export async function getStaticPaths() {
  return (await getContacts()).map(({ data }) => ({
    params: { slug: data.slug },
    props: { contact: data },
  }));
}
interface Props {
  contact: CollectionEntry<'contacts'>['data'];
}
const { contact } = Astro.props;
if (contact.status === 'archived') return Astro.redirect('/kontakt/', 302);
---

<SiteLayout minimal title={contact.name} description={contact.introduction}>
  <article class="personal-card mx-auto max-w-md py-8 text-center sm:py-12">
    <a href="/" aria-label="Rádi bydlíme — úvod" class="inline-block">
      <BrandMark />
    </a>
    <div class="relative mx-auto mt-7 w-52">
      <Image src={craft} width={416} alt="" loading="eager" class="w-full" />
      <span
        aria-hidden="true"
        class="absolute -right-7 bottom-4 -rotate-6 font-annotation text-2xl text-accent"
      >
        S radostí
        <br />a od srdce.
      </span>
    </div>
    <p class="mt-6 text-xs tracking-[0.18em] text-accent uppercase">
      {contact.role}
    </p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">{contact.name}</h1>
    <p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed text-muted">
      {contact.introduction}
    </p>
    <div class="mt-7 grid gap-3">
      <a
        href={`/kontakt/${contact.slug}.vcf`}
        download={`${contact.slug}.vcf`}
        class="contact-action bg-ink text-paper hover:bg-accent"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5" />
        </svg>
        Uložit kontakt
      </a>
      <a
        href={`tel:${contact.phone}`}
        class="contact-action border border-line hover:bg-white/50"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m5 3 4 4-2 3c2 3 4 5 7 7l3-2 4 4c-1 3-4 3-7 2C8 18 3 13 2 7c0-2 1-3 3-4Z" />
        </svg>
        <span>
          Zavolat{' '}
          <span class="block text-xs text-muted">{contact.phoneLabel}</span>
        </span>
      </a>
      <a
        href={`mailto:${contact.email}`}
        class="contact-action border border-line hover:bg-white/50"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="1" />
          <path d="m3 6 9 7 9-7" />
        </svg>
        <span>
          Napsat e-mail{' '}
          <span class="block break-all text-xs text-muted">
            {contact.email}
          </span>
        </span>
      </a>
    </div>
    <nav
      aria-label="Více od nás"
      class="mt-7 flex justify-center gap-7 text-sm"
    >
      <a
        class="underline decoration-line underline-offset-4 hover:text-accent"
        href="/dilny/"
      >
        Naše dílny
      </a>
      <a
        class="underline decoration-line underline-offset-4 hover:text-accent"
        href="/inzerce/"
      >
        Pro radost domů
      </a>
    </nav>
    <p class="my-7 font-annotation text-2xl text-accent">
      Malé radosti. Velký smysl.
    </p>
    <a
      href="/kontakt/"
      class="inline-flex min-h-11 items-center gap-3 text-sm text-accent hover:underline"
    >
      <span aria-hidden="true">←</span> Zpět na kontakty
    </a>
  </article>
</SiteLayout>

<style>
  .contact-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.75rem 1rem;
    border-radius: 4px;
  }
  .contact-action svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
