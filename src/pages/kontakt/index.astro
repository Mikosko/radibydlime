---
import { Image } from 'astro:assets';
import botanical from '../../assets/decor/botanical-stem.png';
import paper from '../../assets/decor/torn-paper.png';
import heartDivider from '../../assets/decor/floral-divider.png';
import house from '../../assets/images/logo-house.png';
import leaf from '../../assets/decor/contact-bouquet.png';
import garden from '../../assets/decor/contact-wheelbarrow.png';
import diy from '../../assets/decor/contact-house.png';
import home from '../../assets/decor/contact-envelope.png';
import PageContainer from '../../components/page-container/PageContainer.astro';
import PageHeader from '../../components/page-header/PageHeader.astro';
import SiteLayout from '../../layouts/site/SiteLayout.astro';

const contactEmail = 'info@radibydlime.cz';
const enquiries = [
  {
    title: 'Jen tak, od vás',
    subject: 'Zpráva od čtenáře',
    description:
      'Otázka k příběhu, vlastní zkušenost nebo jen pozdrav. Rádi si přečteme, co právě tvoříte vy.',
    icon: home,
  },
  {
    title: 'Společný projekt',
    subject: 'Poptávka projektu',
    description:
      'Máte nápad a hledáte někoho, s kým ho probrat? Napište nám svou představu.',
    icon: diy,
  },
  {
    title: 'Něco vám padlo do oka',
    subject: 'Dotaz k nabídce',
    description:
      'Zaujala vás věc z naší nabídky? Připojte odkaz a domluvíme se na podrobnostech.',
    icon: garden,
  },
  {
    title: 'Smysluplná spolupráce',
    subject: 'Nabídka spolupráce',
    description:
      'Blízké jsou nám domov, zahrada a poctivá práce. Povíte nám o svém záměru?',
    icon: leaf,
  },
];
---

<SiteLayout
  title="Kontakt"
  description="Ozvěte se nám. Prostor pro vaše příběhy, otázky, společné projekty a spolupráci. Napište na info@radibydlime.cz."
>
  <PageContainer class="contact-page">
    <PageHeader
      eyebrow="Kontakt"
      title="Ozvěte se nám"
      intro="Rádi si s vámi popovídáme."
      description="Máte dotaz, nápad na spolupráci nebo se chcete jen podělit o svůj příběh? Napište nám — na druhé straně jsme my."
    >
      <div
        slot="artwork"
        class="relative mx-auto w-full max-w-lg pt-12 lg:pt-20"
        aria-hidden="true"
      >
        <p class="absolute top-0 left-5 font-annotation text-3xl leading-tight text-accent -rotate-6 sm:left-10">
          Domov tvoří
          <br />
          lidé a příběhy. <span class="ml-2 font-body text-lg">♥</span>
        </p>
        <Image
          src={house}
          alt=""
          loading="eager"
          widths={[480, 800]}
          sizes="(min-width: 1024px) 520px, 90vw"
          class="h-auto w-full opacity-85"
        />
      </div>
    </PageHeader>

    <div class="grid items-start gap-8 lg:grid-cols-[0.85fr_1.8fr_0.7fr] lg:gap-6">
      <aside aria-label="Jak nás kontaktovat" class="pt-5">
        <div class="flex items-start gap-4">
          <span
            class="grid size-11 shrink-0 place-items-center rounded-full border border-accent text-accent"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5 fill-none stroke-current"
              stroke-width="1.3"
            >
              <rect x="3" y="5" width="18" height="14" rx="1" />
              <path d="m3 6 9 7 9-7" />
            </svg>
          </span>
          <div class="min-w-0">
            <h2 class="font-semibold">E-mail</h2>
            <a
              href={`mailto:${contactEmail}`}
              class="mt-1 inline-block max-w-full break-words text-muted hover:text-accent hover:underline"
            >
              {contactEmail}
            </a>
          </div>
        </div>
        <div class="mt-7 flex items-start gap-4">
          <span
            class="grid size-11 shrink-0 place-items-center rounded-full border border-accent text-accent"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5 fill-none stroke-current"
              stroke-width="1.3"
            >
              <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <div>
            <h2 class="font-semibold">Adresa</h2>
            <address class="mt-1 leading-relaxed text-muted not-italic">
              Tuchořice 37
              <br />
              439 69 Tuchořice
            </address>
          </div>
        </div>
        <p class="mt-6 text-sm leading-relaxed text-muted">
          Mezi prací na domě a rodinnými dny si najdeme čas i na vaše zprávy.
          Pokud jde o konkrétní termín, připište ho prosím rovnou.
        </p>
      </aside>

      <section
        aria-labelledby="napiste-nam"
        class="border border-line bg-white/15 p-5 sm:p-7"
      >
        <h2 id="napiste-nam" class="font-display text-4xl">
          Napište nám
        </h2>
        <form id="contact-draft" class="mt-5" data-email={contactEmail}>
          <fieldset disabled class="grid gap-4">
            <legend class="sr-only">Připravit e-mailovou zprávu</legend>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1.5 text-sm" for="contact-name">
                Jméno{' '}
                <input
                  id="contact-name"
                  name="name"
                  autocomplete="name"
                  maxlength="120"
                  placeholder="Vaše jméno"
                />
              </label>
              <label class="grid gap-1.5 text-sm" for="contact-email">
                E-mail{' '}
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  maxlength="254"
                  placeholder="Váš e-mail (nepovinné)"
                />
              </label>
            </div>
            <label class="grid gap-1.5 text-sm" for="contact-topic">
              O čem si napíšeme?{' '}
              <select id="contact-topic" name="subject">
                {enquiries.map(({ title, subject }) => (
                  <option value={subject}>{title}</option>
                ))}
              </select>
            </label>
            <label class="grid gap-1.5 text-sm" for="contact-message">
              Zpráva (povinné){' '}
              <textarea
                id="contact-message"
                name="message"
                required
                rows="6"
                maxlength="3000"
                placeholder="Napište nám, co vám leží na srdci…"
              ></textarea>
            </label>
            <p id="email-help" class="text-xs leading-relaxed text-muted">
              Tlačítko otevře váš e-mailový program s připravenou zprávou.
              Odešlete ji až tam. Tento formulář nic neodesílá ani neukládá.
            </p>
            <button
              type="submit"
              aria-describedby="email-help"
              class="min-h-12 bg-ink px-4 py-3 text-sm font-semibold tracking-[0.1em] text-paper uppercase hover:bg-ink/90"
            >
              Připravit e-mail{' '}
              <span aria-hidden="true" class="ml-2">
                →
              </span>
            </button>
          </fieldset>
          <noscript>
            <p class="mt-4 text-sm">
              Pro přípravu zprávy zapněte JavaScript, nebo napište přímo na{' '}
              <a href={`mailto:${contactEmail}`} class="underline">
                {contactEmail}
              </a>
              .
            </p>
          </noscript>
          <p
            id="email-status"
            role="status"
            class="mt-3 text-sm leading-relaxed text-muted"
          ></p>
        </form>
      </section>

      <aside aria-label="Osobní vzkaz" class="lg:mt-7 lg:pl-5">
        <div class="relative isolate mx-auto flex max-w-xs flex-col items-center px-7 py-9 text-center">
          <Image
            src={paper}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 size-full opacity-60"
          />
          <Image
            src={botanical}
            alt=""
            aria-hidden="true"
            class="mb-4 h-28 w-20 object-contain opacity-85"
          />
          <p class="font-display text-2xl leading-snug">
            Spolupráce,
            <br />
            nápady, dotazy.
            <br />
            Jsme tu pro vás.
          </p>
          <span class="mt-4 text-xl text-accent" aria-hidden="true">
            ♥
          </span>
        </div>
        <p class="mt-6 border-t border-line pt-5 text-center font-annotation text-3xl leading-tight text-accent -rotate-3">
          Těšíme se
          <br />
          na vaše zprávy.
        </p>
      </aside>
    </div>
  </PageContainer>
  <section
    slot="footer-intro"
    aria-labelledby="kontakt-temata"
    class="mx-auto mt-20 w-full max-w-[92rem] px-5 sm:mt-24 sm:px-8"
  >
    <div>
      <h2
        id="kontakt-temata"
        class="px-6 pt-8 text-center font-display text-3xl sm:text-4xl"
      >
        S čím se nám můžete ozvat
      </h2>
      <Image
        src={heartDivider}
        alt=""
        aria-hidden="true"
        loading="lazy"
        width={350}
        class="mx-auto mt-4 h-auto w-56 max-w-full sm:w-64"
      />
      <ul class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 border-y border-line">
        {enquiries.map(({ title, subject, description, icon }, index) => (
          <li
            class:list={[
              'border-line',
              index > 0 && 'border-t sm:border-t-0',
              index % 2 === 1 && 'sm:border-l',
              index > 1 && 'sm:border-t lg:border-t-0',
              index === 2 && 'lg:border-l',
            ]}
          >
            <a
              href={`mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`}
              class="group grid h-full grid-rows-[8rem_auto_1fr] content-start justify-items-center px-6 py-9 text-center hover:bg-white/25 focus-visible:relative focus-visible:z-10 sm:px-8 sm:py-12"
            >
              <Image
                src={icon}
                alt=""
                aria-hidden="true"
                loading="lazy"
                width={320}
                class="h-32 w-40 object-contain opacity-85"
              />
              <h3 class="mt-4 font-editorial-note text-xs leading-snug tracking-[0.08em] uppercase">
                {title}
              </h3>
              <p class="mt-3 max-w-60 text-sm leading-relaxed text-muted">
                {description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--color-line);
    background: transparent;
    padding: 0.65rem 0.8rem;
    border-radius: 0;
    color: var(--color-ink);
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--color-muted);
    opacity: 0.8;
  }
  textarea {
    resize: vertical;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-draft');
  if (form) {
    form.querySelector('fieldset')!.disabled = false;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const body = [
        String(data.get('message') ?? ''),
        '',
        String(data.get('name') ?? ''),
        String(data.get('email') ?? ''),
      ]
        .join('\n')
        .trim();
      const destination = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get('subject')))}&body=${encodeURIComponent(body)}`;
      window.location.href = destination;
      document.querySelector('#email-status')!.textContent =
        'Pokud se e-mailový program neotevřel, zkopírujte zprávu a pošlete ji přímo na info@radibydlime.cz. Text tu zůstává pro vás.';
    });
  }
</script>
