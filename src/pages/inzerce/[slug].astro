---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/site/SiteLayout.astro';
import PageContainer from '../../components/page-container/PageContainer.astro';
import MediaImage from '../../components/media-image/MediaImage.astro';
import ArticleGallery from '../../components/article-gallery/ArticleGallery.astro';
import { getMediaCatalog } from '../../content/media/query';
import {
  getPublishedSaleItems,
  availabilityLabels,
  formatPrice,
} from '../../content/sale-items/query';
import paper from '../../assets/decor/torn-paper.png';
import botanical from '../../assets/decor/botanical-daisies.png';

export async function getStaticPaths() {
  const catalog = await getMediaCatalog();
  return (await getPublishedSaleItems(catalog)).map((item) => ({
    params: { slug: item.data.slug },
    props: { item, catalog },
  }));
}
interface Props {
  item: Awaited<ReturnType<typeof getPublishedSaleItems>>[number];
  catalog: Awaited<ReturnType<typeof getMediaCatalog>>;
}
const { item, catalog } = Astro.props;
const { data, cover, images } = item;
const { Content } = await render(item);
const canEnquire = data.sample || data.availability === 'available';
---

<SiteLayout title={data.title} description={data.summary}>
  <PageContainer>
    <nav aria-label="Drobečková navigace" class="mb-7 text-sm text-muted">
      <a
        href="/inzerce/"
        class="inline-flex min-h-11 items-center gap-3 text-accent hover:underline"
      >
        ← Zpět na inzerci
      </a>
      <span aria-hidden="true" class="mx-3">
        /
      </span>
      <span>{data.category}</span>
    </nav>
    <div class="grid items-start gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div class="min-w-0">
        <div class="relative border border-line bg-white/20 p-2 shadow-sm">
          {'width' in cover ? (
            <MediaImage
              mediaId={cover.id}
              {catalog}
              loading="eager"
              class="max-h-[38rem] w-full object-contain"
            />
          ) : (
            <Image
              src={cover.src}
              alt={cover.alt}
              loading="eager"
              widths={[600, 1000]}
              sizes="(min-width:1024px) 650px, 90vw"
              class="max-h-[38rem] w-full object-contain"
            />
          )}
          <div class="absolute top-5 left-5 isolate px-5 py-6 text-center">
            <Image
              src={paper}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 -z-10 size-full"
            />
            <p class="font-editorial-note text-sm">
              {data.sample
                ? 'Ukázka nabídky'
                : availabilityLabels[data.availability]}
            </p>
            <span aria-hidden="true" class="mt-2 block text-accent">
              ♥
            </span>
          </div>
        </div>
        <ArticleGallery
          items={images}
          {catalog}
          title="Zblízka i v detailu"
          eyebrow={
            data.sample ? 'Ilustrační fotografie' : 'Fotografie předmětu'
          }
        />
      </div>
      <div class="min-w-0 pt-2">
        <p class="text-xs font-semibold tracking-[0.18em] text-muted uppercase">
          Inzerce · {data.category}
        </p>
        <h1 class="mt-4 font-display text-5xl leading-tight sm:text-6xl">
          {data.title}
        </h1>
        <p class="mt-5 text-2xl">
          {data.sample ? 'Ukázková položka' : formatPrice(data.priceCzk)}
        </p>
        <p class="mt-5 text-lg leading-relaxed text-muted">{data.summary}</p>
        {data.sample && (
          <p class="mt-5 border-l-2 border-accent pl-4 text-sm leading-relaxed text-muted">
            Toto je ukázka, nikoli aktuální nabídka k prodeji. Snímky ukazují
            ilustrační předmět a prostředí obnovy, ne různé pohledy na skutečný
            prodávaný kus.
          </p>
        )}
        <dl class="mt-7 divide-y divide-line border-y border-line text-sm">
          <div class="py-4">
            <dt class="font-semibold">Stav a podrobnosti</dt>
            <dd class="mt-2 leading-relaxed text-muted">{data.condition}</dd>
          </div>
          <div class="py-4">
            <dt class="font-semibold">Předání</dt>
            <dd class="mt-2 leading-relaxed text-muted">{data.handover}</dd>
          </div>
          {!data.sample && (
            <div class="py-4">
              <dt class="font-semibold">Dostupnost</dt>
              <dd class="mt-2 text-muted">
                {availabilityLabels[data.availability]}
              </dd>
            </div>
          )}
        </dl>
        {canEnquire ? (
          <>
            <a
              href={`mailto:info@radibydlime.cz?subject=${encodeURIComponent(`Dotaz k inzerci: ${data.title} (${data.id})`)}`}
              class="mt-7 inline-flex min-h-12 items-center gap-8 bg-ink px-6 py-3 text-paper hover:bg-ink/90"
            >
              Napsat k předmětu <span aria-hidden="true">→</span>
            </a>
            <p class="mt-3 text-xs leading-relaxed text-muted">
              Otevře váš e-mail. Dostupnost a předání potvrdíme osobně; nejde o
              objednávku ani rezervaci.
            </p>
          </>
        ) : (
          <p class="mt-7 border border-line px-5 py-4">
            {data.availability === 'sold'
              ? 'Tahle věc už našla nový domov.'
              : 'Tuhle věc máme právě zamluvenou.'}
          </p>
        )}
        <p class="mt-8 font-annotation text-3xl text-accent -rotate-3">
          Každý kousek má svůj příběh.
        </p>
      </div>
    </div>
    <section
      aria-label="Příběh a podrobnosti předmětu"
      class="mt-12 grid items-center gap-10 border-t border-line pt-8 md:grid-cols-[1fr_14rem]"
    >
      <div class="narrative max-w-3xl">
        <Content />
      </div>
      <Image
        src={botanical}
        alt=""
        aria-hidden="true"
        loading="lazy"
        width={300}
        class="mx-auto hidden max-h-64 w-auto opacity-80 md:block"
      />
    </section>
    <a
      href="/inzerce/"
      class="mt-10 inline-flex min-h-11 items-center gap-3 text-accent hover:underline"
    >
      ← Další věci z naší nabídky
    </a>
  </PageContainer>
</SiteLayout>
