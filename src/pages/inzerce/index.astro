---
import SaleCard from '../../components/sale-card/SaleCard.astro';
import { Image } from 'astro:assets';
import { summarizePrice } from '../../content/sale-items/pricing';
import PageContainer from '../../components/page-container/PageContainer.astro';
import PageHeader from '../../components/page-header/PageHeader.astro';
import SiteLayout from '../../layouts/site/SiteLayout.astro';
import EditorialLink from '../../components/editorial-link/EditorialLink.astro';
import paper from '../../assets/decor/torn-paper.png';
import divider from '../../assets/decor/floral-divider.png';
import MediaImage from '../../components/media-image/MediaImage.astro';
import { getMediaCatalog } from '../../content/media/query';
import {
  getPublishedSaleItems,
  availabilityLabels,
  formatPrice,
} from '../../content/sale-items/query';
const catalog = await getMediaCatalog();
const items = await getPublishedSaleItems(catalog);
const cutouts = items.filter(({ data }) => data.imagePresentation === 'cutout');
const displayItems = [
  ...cutouts,
  ...items.filter(({ data }) => data.imagePresentation !== 'cutout'),
];
const featuredItems = cutouts;
const featured = featuredItems[0];
---

<SiteLayout
  title="Inzerce"
  description="Věci z našeho domu, dílny a zahrady pro další příběh. Připravujeme vlastní nabídku Rádi bydlíme."
>
  <PageContainer>
    <PageHeader
      eyebrow="Inzerce · od nás k vám"
      title="Věci, které mají příběh"
      intro="Při obnově domu se nám občas do rukou dostanou věci, které už u nás místo nenajdou. Rádi bychom jim pomohli najít nový domov."
      description="Naše vlastní nabídka z domu, dílny i zahrady. U každé věci najdete podrobnosti, fotografie a možnost napsat nám přímo."
    >
      <!-- <p slot="annotation" class="mt-7 flex items-center gap-5 text-accent">
        <span aria-hidden="true" class="text-2xl">
          ♥
        </span>
        <span class="font-annotation text-3xl -rotate-3">
          Další domov.
          <br />
          Další příběh.
        </span>
      </p> -->
      {featured && (
        <sale-carousel
          slot="artwork"
          class="group relative block min-w-0"
          role="region"
          aria-roledescription="karusel"
          aria-label="Z naší nabídky"
        >
          <div class="overflow-hidden pt-2 pb-5">
            <div data-track class="flex items-start">
              {featuredItems.map((featured, index) => (
                <div
                  data-slide
                  hidden={index > 0}
                  role="group"
                  aria-roledescription="snímek"
                  aria-label={`${index + 1} z ${featuredItems.length}: ${featured.data.title}`}
                  class="sale-still-life relative isolate w-full shrink-0 px-7 sm:px-10"
                >
                  <div class="relative z-10 mb-1">
                    <p class="text-xs tracking-widest text-accent uppercase">
                      {featured.data.category}
                    </p>
                    <h2 class="mt-1 font-display text-3xl leading-tight">
                      {featured.data.title}
                    </h2>
                  </div>
                  <div class="relative">
                    <div class="absolute top-3 left-0 z-10 flex flex-wrap gap-2">
                      {featured.data.availability === 'reserved' && (
                        <span class="rounded-sm bg-paper/95 px-3 py-1.5 text-xs text-accent">
                          {availabilityLabels[featured.data.availability]}
                        </span>
                      )}
                      {summarizePrice(featured.data).discount !== undefined &&
                        featured.data.availability === 'available' && (
                          <span class="rounded-sm bg-accent px-3 py-1.5 text-xs text-paper">
                            {summarizePrice(featured.data).discount}
                          </span>
                        )}
                      {featured.data.unique && (
                        <span class="rounded-sm bg-ink/90 px-3 py-1.5 text-xs text-paper">
                          Jediný kus
                        </span>
                      )}
                    </div>
                    <a
                      href={`/inzerce/${featured.data.slug}/`}
                      class="block"
                      aria-label={`Prohlédnout: ${featured.data.title}`}
                    >
                      {'width' in featured.cover ? (
                        <MediaImage
                          mediaId={featured.cover.id}
                          {catalog}
                          loading="eager"
                          class="mx-auto h-[18rem] w-full object-contain sm:h-[20rem]"
                        />
                      ) : (
                        <Image
                          src={featured.cover.src}
                          alt={featured.cover.alt}
                          loading="eager"
                          widths={[480, 800]}
                          sizes="(min-width:1024px) 560px, 90vw"
                          class="mx-auto h-[18rem] w-full object-contain sm:h-[20rem]"
                        />
                      )}
                    </a>
                  </div>
                  <aside class="relative -mt-24 ml-auto w-48 max-w-full rotate-[-4deg] px-6 py-5 sm:-mt-28 sm:w-52">
                    <Image
                      src={paper}
                      alt=""
                      aria-hidden="true"
                      class="absolute inset-0 -z-10 size-full object-fill drop-shadow-sm"
                    />
                    {summarizePrice(featured.data).original !== undefined && (
                      <p class="mb-1 text-sm text-muted">
                        <span class="sr-only">Původní cena: </span>
                        <s>{formatPrice(featured.data.priceCzk)}</s>
                      </p>
                    )}
                    <div class="relative">
                      <p
                        class:list={[
                          'text-3xl font-semibold sm:text-4xl',
                          featured.data.availability === 'sold' &&
                            'text-muted/50',
                        ]}
                      >
                        {featured.data.availability === 'sold' && (
                          <span class="sr-only">Původní cena: </span>
                        )}
                        {summarizePrice(featured.data).text}
                      </p>
                      {featured.data.availability === 'sold' && (
                        <span class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-12 border-[3px] border-accent bg-paper/90 px-2 py-1 font-body text-2xl leading-none font-semibold tracking-wider whitespace-nowrap text-accent uppercase">
                          Prodáno
                        </span>
                      )}
                    </div>

                    <EditorialLink
                      href={`/inzerce/${featured.data.slug}/`}
                      class="mt-1 text-sm"
                    >
                      Prohlédnout
                    </EditorialLink>
                  </aside>
                </div>
              ))}
            </div>
          </div>
          {featuredItems.length > 1 && (
            <div data-controls hidden>
              <button
                type="button"
                data-prev
                aria-label="Předchozí předmět"
                class="sale-arrow left-1"
              >
                {' '}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path d="m15 5-7 7 7 7" />
                </svg>
              </button>
              <button
                type="button"
                data-next
                aria-label="Další předmět"
                class="sale-arrow right-1"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path d="m9 5 7 7-7 7" />
                </svg>
              </button>
              <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
                {featuredItems.map((item, index) => (
                  <button
                    type="button"
                    data-dot
                    aria-label={`Zobrazit: ${item.data.title}`}
                    aria-current={index === 0 ? 'true' : undefined}
                    class="slide-dot grid size-11 place-items-center"
                  >
                    <span class="block h-1.5 w-5 rounded-full bg-line" />
                  </button>
                ))}
                <span data-count class="ml-2 text-xs tabular-nums text-muted">
                  1 / {featuredItems.length}
                </span>
                <button
                  type="button"
                  data-pause
                  class="ml-2 min-h-11 px-2 text-xs text-muted"
                  aria-label="Pozastavit automatické střídání"
                >
                  Pozastavit
                </button>
              </div>
            </div>
          )}
        </sale-carousel>
      )}
    </PageHeader>

    <section aria-labelledby="nabidka" class="pt-8">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
        <div>
          <p class="text-xs tracking-widest text-accent uppercase">
            Od nás k vám
          </p>
          <h2 id="nabidka" class="mt-2 font-display text-4xl sm:text-5xl">
            Věci pro další příběh
          </h2>
        </div>
        <p class="text-sm text-muted">Počet položek: {items.length}</p>
      </div>
      <ul class="mt-8 grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {displayItems.map((item) => (
          <li>
            <SaleCard {item} {catalog} />
          </li>
        ))}
      </ul>
      {items.length === 0 && (
        <p class="py-12 text-muted">
          Právě tu nic nenabízíme. Další věci přidáme, až budou připravené.
        </p>
      )}
    </section>
  </PageContainer>
  <section
    slot="footer-intro"
    aria-labelledby="domluva"
    class="mx-auto mt-14 w-full max-w-[78rem] px-5 text-center sm:mt-20 sm:px-8"
  >
    <Image
      src={divider}
      alt=""
      aria-hidden="true"
      loading="lazy"
      width={600}
      class="mx-auto mb-7 h-auto w-full max-w-md"
    />
    <p class="text-xs font-semibold tracking-[0.18em] uppercase">
      Osobně a po domluvě
    </p>
    <h2 id="domluva" class="mt-3 font-display text-4xl sm:text-5xl">
      Zaujalo vás něco? Napište nám.
    </h2>
    <p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">
      Na dostupnosti, ceně i předání se vždy domluvíme přímo. Jsme v Tuchořicích
      a nejraději začínáme obyčejným rozhovorem.
    </p>
    <a
      href="mailto:info@radibydlime.cz?subject=Dotaz%20k%20inzerci"
      class="mt-6 inline-flex min-h-12 items-center gap-6 bg-ink px-7 py-3 text-sm text-paper hover:bg-ink/90"
    >
      info@radibydlime.cz <span aria-hidden="true">→</span>
    </a>
    <p class="mt-4 text-xs text-muted">
      E-mail je nezávazný dotaz, nikoli objednávka.
    </p>
  </section>
</SiteLayout>

<style>
  [data-track] {
    transition: transform 800ms cubic-bezier(0.22, 0.68, 0.22, 1);
  }
  .sale-arrow {
    position: absolute;
    top: 38%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    opacity: 0;
    transition: opacity 180ms;
    box-shadow: 0 2px 10px #293c3014;
  }
  sale-carousel:hover .sale-arrow,
  sale-carousel:focus-within .sale-arrow {
    opacity: 1;
  }
  .slide-dot span {
    position: relative;
    overflow: hidden;
    transition: width 250ms ease;
  }
  .slide-dot[aria-current='true'] span {
    width: 2rem;
    background: color-mix(in srgb, var(--color-accent) 25%, var(--color-paper));
  }
  .slide-dot[aria-current='true'] span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--slide-progress, 0));
  }
  @media (prefers-reduced-motion: reduce) {
    .slide-dot span {
      transition: none;
    }
    .slide-dot[aria-current='true'] span::after {
      transform: none;
    }
  }
  @media (hover: none) {
    .sale-arrow {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-track],
    .sale-arrow {
      transition: none;
    }
  }
</style>
<script>
  class SaleCarousel extends HTMLElement {
    connectedCallback() {
      const slides = [...this.querySelectorAll<HTMLElement>('[data-slide]')];
      const track = this.querySelector<HTMLElement>('[data-track]')!;
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      if (slides.length < 2 || !controls) return;
      slides.forEach((slide) => {
        slide.hidden = false;
      });
      const dots = [...this.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      const pause = this.querySelector<HTMLButtonElement>('[data-pause]')!;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      let current = 0;
      let elapsed = 0;
      let paused = reduced.matches;
      const show = (index: number) => {
        elapsed = 0;
        this.style.setProperty('--slide-progress', '0');
        current = (index + slides.length) % slides.length;
        track.style.transform = `translateX(-${current * 100}%)`;
        slides.forEach((slide, i) => {
          slide.inert = i !== current;
          slide.setAttribute('aria-hidden', String(i !== current));
        });
        dots.forEach((dot, i) => {
          if (i === current) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        this.querySelector('[data-count]')!.textContent =
          `${current + 1} / ${slides.length}`;
      };
      const label = () => {
        pause.textContent = paused ? 'Spustit' : 'Pozastavit';
        pause.setAttribute(
          'aria-label',
          paused
            ? 'Spustit automatické střídání'
            : 'Pozastavit automatické střídání',
        );
      };
      this.querySelector('[data-prev]')!.addEventListener('click', () =>
        show(current - 1),
      );
      this.querySelector('[data-next]')!.addEventListener('click', () =>
        show(current + 1),
      );
      dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
      pause.addEventListener('click', () => {
        paused = !paused;
        label();
      });
      let lastWheel = -Infinity;
      let wheelDistance = 0;
      let wheelAdvanced = false;
      const onWheel = (event: WheelEvent) => {
        // Leave vertical scrolling and browser pinch-to-zoom untouched.
        if (event.ctrlKey || Math.abs(event.deltaX) <= Math.abs(event.deltaY))
          return;
        event.preventDefault();
        const now = performance.now();
        if (now - lastWheel > 220) {
          wheelDistance = 0;
          wheelAdvanced = false;
        }
        lastWheel = now;
        const unit =
          event.deltaMode === 1
            ? 16
            : event.deltaMode === 2
              ? this.clientWidth
              : 1;
        wheelDistance += event.deltaX * unit;
        if (!wheelAdvanced && Math.abs(wheelDistance) >= 40) {
          show(current + Math.sign(wheelDistance));
          wheelAdvanced = true;
        }
      };
      this.addEventListener('wheel', onWheel, { passive: false });
      const onMotion = () => {
        if (reduced.matches) {
          paused = true;
          label();
        }
      };
      reduced.addEventListener('change', onMotion);
      let last = performance.now();
      let frame = 0;
      const tick = (now: number) => {
        const delta = Math.min(now - last, 100);
        last = now;
        if (
          !paused &&
          now - lastWheel > 800 &&
          !document.hidden &&
          !this.matches(':hover') &&
          !this.contains(document.activeElement)
        ) {
          elapsed += delta;
          if (elapsed >= 5500) show(current + 1);
          this.style.setProperty('--slide-progress', String(elapsed / 5500));
        }
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
      this.cleanup = () => {
        cancelAnimationFrame(frame);
        this.removeEventListener('wheel', onWheel);
        reduced.removeEventListener('change', onMotion);
      };
      controls.hidden = false;
      show(0);
      label();
    }
    cleanup?: () => void;
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('sale-carousel'))
    customElements.define('sale-carousel', SaleCarousel);
</script>
