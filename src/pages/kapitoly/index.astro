---
import { Image } from 'astro:assets';
import EditorialLink from '../../components/editorial-link/EditorialLink.astro';
import paper from '../../assets/decor/torn-paper.png';
import terrace from '../../assets/decor/project.png';
import MediaImage from '../../components/media-image/MediaImage.astro';
import { getMediaCatalog } from '../../content/media/query';
import { getPublishedProjects } from '../../content/projects/query';
import PageContainer from '../../components/page-container/PageContainer.astro';
import PageHeader from '../../components/page-header/PageHeader.astro';
import SiteLayout from '../../layouts/site/SiteLayout.astro';

const catalog = await getMediaCatalog();
const projects = await getPublishedProjects(catalog);
const formatDate = (date: Date) =>
  date.toLocaleDateString('cs-CZ', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<SiteLayout
  title="Kapitoly"
  description="Příběhy obnovy našeho domu, práce v dílně a života na zahradě."
>
  <PageContainer>
    <PageHeader
      eyebrow="Dům · dílna · zahrada"
      title="Kapitoly"
      intro="Příběhy, ze kterých roste domov."
      description="Starý dům se neobnoví v jediném příběhu. Tady si ukládáme práci, objevy i rozhodnutí, která nás postupně vedou dál."
      class="border-b border-line"
    >
      <div slot="artwork" class="mx-auto flex w-full max-w-xl items-center">
        <Image
          src={terrace}
          alt=""
          aria-hidden="true"
          loading="eager"
          widths={[360, 690]}
          sizes="(min-width: 640px) 345px, 60vw"
          class="pointer-events-none h-auto max-h-[300px] min-w-0 flex-1 object-contain"
        />
        <aside
          aria-label="Malý vzkaz"
          class="relative z-10 isolate -ml-6 w-28 shrink-0 px-3 py-6 text-center rotate-5 sm:w-32"
        >
          <Image
            src={paper}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 -z-10 size-full"
          />
          <p class="font-annotation text-2xl leading-tight">
            Po kouscích
            <br />
            se rodí
            <br />
            domov.
          </p>
          <span aria-hidden="true" class="mt-3 block text-lg text-accent">
            ♥
          </span>
        </aside>
      </div>
    </PageHeader>

    {projects.length > 0 ? (
      <ul class="mt-8 divide-y divide-line border-b border-line">
        {projects.map(({ data, hero, author, gallery }, index) => {
          const heroKey = 'width' in hero ? hero.id : hero.src.src;
          const details = gallery
            .filter(
              (photo) =>
                ('width' in photo ? photo.id : photo.src.src) !== heroKey,
            )
            .slice(0, 2);
          return (
            <li class="py-9 first:pt-0 sm:py-11">
              <article class="grid items-start gap-7 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] lg:gap-12">
                <div class="min-w-0 pt-1">
                  <p class="text-xs tracking-[0.14em] text-accent uppercase">
                    {data.topic}
                    {index === 0 && (
                      <span class="ml-3 border-l border-line pl-3 text-muted">
                        Nejnovější
                      </span>
                    )}
                  </p>
                  <h2 class="mt-4 max-w-lg font-display text-4xl leading-tight sm:text-5xl">
                    <a
                      href={`/projekty/${data.slug}/`}
                      class="hover:text-accent"
                    >
                      {data.title}
                    </a>
                  </h2>
                  <p class="mt-4 max-w-lg leading-relaxed text-muted">
                    {data.summary}
                  </p>
                  <div class="mt-5 flex items-center gap-3 text-sm">
                    <Image
                      src={author.portrait}
                      alt=""
                      aria-hidden="true"
                      width={40}
                      loading="lazy"
                      class="size-9 shrink-0 rounded-full object-cover"
                    />
                    <div>
                      <p>{author.name}</p>
                      <time
                        datetime={data.publishedAt.toISOString()}
                        class="mt-0.5 block text-xs text-muted"
                      >
                        {formatDate(data.publishedAt)}
                      </time>
                    </div>
                  </div>
                  <EditorialLink
                    href={`/projekty/${data.slug}/`}
                    aria-label={`Číst kapitolu: ${data.title}`}
                    class="mt-5"
                  >
                    Číst kapitolu
                  </EditorialLink>
                </div>
                <a
                  href={`/projekty/${data.slug}/`}
                  aria-label={`Otevřít kapitolu: ${data.title}`}
                  class:list={[
                    'chapter-photos group grid min-w-0 gap-2',
                    details.length > 0 && 'has-details',
                  ]}
                >
                  <div class="min-h-0 overflow-hidden rounded-sm bg-line/30">
                    {'width' in hero ? (
                      <MediaImage
                        mediaId={hero.id}
                        {catalog}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        class="size-full object-cover group-hover:opacity-90"
                      />
                    ) : (
                      <Image
                        src={hero.src}
                        alt={hero.alt}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        widths={[480, 800]}
                        sizes="(min-width:1024px) 550px, 90vw"
                        class="size-full object-cover group-hover:opacity-90"
                      />
                    )}
                  </div>
                  {details.length > 0 && (
                    <div class="grid min-h-0 grid-cols-2 gap-2 sm:grid-cols-1">
                      {details.map((photo) => (
                        <div class="min-h-0 min-w-0 overflow-hidden rounded-sm bg-line/30">
                          {'width' in photo ? (
                            <MediaImage
                              mediaId={photo.id}
                              {catalog}
                              class="size-full object-cover group-hover:opacity-90"
                            />
                          ) : (
                            <Image
                              src={photo.src}
                              alt={photo.alt}
                              loading="lazy"
                              widths={[240, 480]}
                              sizes="(min-width:1024px) 200px, 45vw"
                              class="size-full object-cover group-hover:opacity-90"
                            />
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </a>
              </article>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="py-16 text-lg text-muted">
        První kapitolu právě chystáme. Brzy tu bude mít své místo.
      </p>
    )}
  </PageContainer>
</SiteLayout>

<style>
  .chapter-photos {
    grid-template-rows: minmax(0, 15rem);
  }
  .chapter-photos.has-details {
    grid-template-rows: minmax(0, 15rem) minmax(0, 7rem);
  }
  @media (min-width: 640px) {
    .chapter-photos,
    .chapter-photos.has-details {
      height: 22rem;
      grid-template-rows: minmax(0, 1fr);
    }
    .chapter-photos.has-details {
      grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
    }
  }
</style>
