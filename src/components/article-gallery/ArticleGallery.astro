---
import { Image } from 'astro:assets';
import FigureCaption from '../figure-caption/FigureCaption.astro';
import MediaImage from '../media-image/MediaImage.astro';
import type { getMediaCatalog } from '../../content/media/query';
import type { getPublishedProjects } from '../../content/projects/query';

type Gallery = Awaited<
  ReturnType<typeof getPublishedProjects>
>[number]['gallery'];

interface Props {
  items: Gallery;
  layout?: 'strip' | 'grid';
  title?: string;
  eyebrow?: string;
  catalog: Awaited<ReturnType<typeof getMediaCatalog>>;
}

const {
  items,
  catalog,
  layout = 'strip',
  title = 'Obrazový deník',
  eyebrow = 'Z této kapitoly',
} = Astro.props;
---

{items.length > 0 && (
  <section
    aria-labelledby="obrazovy-denik"
    data-article-gallery
    class="mt-14 pt-7"
  >
    <div class="mb-7 flex items-end gap-6">
      <div>
        <p class="font-editorial-note text-[0.65rem] tracking-[0.14em] text-accent uppercase">
          {eyebrow}
        </p>
        <h2
          id="obrazovy-denik"
          class="mt-2 font-display text-4xl leading-none sm:text-5xl"
        >
          {title}
        </h2>
      </div>
      <span class="mb-1 h-px flex-1 bg-line" aria-hidden="true"></span>
    </div>

    <p class="mb-3 text-sm text-muted">
      Vyberte fotografii pro větší zobrazení.
    </p>
    <div
      role="group"
      aria-label={title}
      class:list={[
        layout === 'grid'
          ? 'grid gap-x-6 gap-y-9 pb-4 sm:grid-cols-2 lg:grid-cols-3'
          : 'flex snap-x snap-mandatory gap-3 overflow-x-auto pb-4 sm:gap-4',
      ]}
    >
      {items.map((item, index) => (
        <div
          class:list={[
            layout === 'strip' && 'w-44 shrink-0 snap-start sm:w-56 lg:w-64',
          ]}
        >
          <button
            type="button"
            data-gallery-open={index}
            aria-label={`Zobrazit fotografii ${index + 1} z ${items.length}: ${item.caption ?? item.alt}`}
            class="group block w-full cursor-zoom-in text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {'width' in item ? (
              <MediaImage
                mediaId={item.id}
                catalog={catalog}
                loading="lazy"
                class="aspect-[4/3] w-full bg-line object-cover transition-opacity group-hover:opacity-80"
              />
            ) : (
              <Image
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="aspect-[4/3] w-full bg-line object-cover transition-opacity group-hover:opacity-80"
              />
            )}
            <span class="mt-2 block font-editorial-note text-xs text-muted">
              {String(index + 1).padStart(2, '0')} /{' '}
              {String(items.length).padStart(2, '0')}
            </span>
            {layout === 'grid' && (
              <span class="mt-2 block font-display text-xl leading-snug">
                {item.caption ?? item.alt}
              </span>
            )}
          </button>
        </div>
      ))}
    </div>

    {items.map((item, index) => (
      <dialog
        data-gallery-dialog={index}
        aria-labelledby={`gallery-title-${index}`}
        class="m-auto max-h-[95dvh] w-[min(95vw,1100px)] max-w-none border border-line bg-paper p-4 text-ink shadow-2xl backdrop:bg-ink/90 backdrop:backdrop-blur-sm sm:p-6"
      >
        <div class="mb-3 flex items-start justify-between gap-4">
          <h3
            id={`gallery-title-${index}`}
            class="font-editorial-note text-sm tracking-wide"
          >
            Fotografie {index + 1} z {items.length}
          </h3>
          <form method="dialog">
            <button
              type="submit"
              aria-label="Zavřít fotografii"
              class="-m-1 grid size-10 place-items-center text-xl text-primary hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span aria-hidden="true">×</span>
            </button>
          </form>
        </div>
        <figure>
          <div class="group relative mx-auto w-fit max-w-full">
            {'width' in item ? (
              <MediaImage
                mediaId={item.id}
                catalog={catalog}
                loading="lazy"
                class="block max-h-[70dvh] max-w-full bg-line object-contain"
              />
            ) : (
              <Image
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="block max-h-[70dvh] max-w-full bg-line object-contain"
              />
            )}
            {index > 0 && (
              <button
                type="button"
                data-gallery-step="-1"
                aria-label="Předchozí fotografie"
                class="pointer-events-none absolute inset-y-0 left-2 my-auto grid size-11 place-items-center rounded-full bg-paper/90 text-primary opacity-0 shadow-md transition-opacity hover:bg-paper hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 sm:left-4"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  class="size-5 fill-none stroke-current stroke-2"
                >
                  <path
                    d="m15 18-6-6 6-6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </button>
            )}
            {index < items.length - 1 && (
              <button
                type="button"
                data-gallery-step="1"
                aria-label="Další fotografie"
                class="pointer-events-none absolute inset-y-0 right-2 my-auto grid size-11 place-items-center rounded-full bg-paper/90 text-primary opacity-0 shadow-md transition-opacity hover:bg-paper hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100 sm:right-4"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  class="size-5 fill-none stroke-current stroke-2"
                >
                  <path
                    d="m9 18 6-6-6-6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </button>
            )}
          </div>
          <FigureCaption
            caption={item.caption ?? item.alt}
            credit={item.credit}
          />
        </figure>
      </dialog>
    ))}
  </section>
)}

<script>
  function initializeGallery(gallery: HTMLElement) {
    if (gallery.dataset.initialized === 'true') return;
    gallery.dataset.initialized = 'true';

    const dialogs = Array.from(
      gallery.querySelectorAll<HTMLDialogElement>('[data-gallery-dialog]'),
    );
    const openAt = (index: number) => {
      const next = dialogs[index];
      if (!next) return;
      dialogs.find((dialog) => dialog.open)?.close();
      next.showModal();
    };
    gallery
      .querySelectorAll<HTMLButtonElement>('[data-gallery-open]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          openAt(Number(button.dataset.galleryOpen));
        });
      });

    dialogs.forEach((dialog, index) => {
      dialog
        .querySelectorAll<HTMLButtonElement>('[data-gallery-step]')
        .forEach((button) => {
          button.addEventListener('click', () => {
            openAt(index + Number(button.dataset.galleryStep));
          });
        });
      dialog.addEventListener('keydown', (event) => {
        const step =
          event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0;
        if (!step || !dialogs[index + step]) return;
        event.preventDefault();
        openAt(index + step);
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  document
    .querySelectorAll<HTMLElement>('[data-article-gallery]')
    .forEach(initializeGallery);
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLElement>('[data-article-gallery]')
      .forEach(initializeGallery);
  });
</script>
