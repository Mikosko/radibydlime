---
interface Props {
  href: string;
  class?: string;
  'aria-label'?: string;
}
const { href, class: className, 'aria-label': ariaLabel } = Astro.props;
---

<a
  {href}
  aria-label={ariaLabel}
  class:list={[
    'editorial-link pen-underline relative inline-flex min-h-11 items-center gap-4 text-xs tracking-[0.1em] text-accent uppercase',
    className,
  ]}
>
  <slot /> <span aria-hidden="true">→</span>
</a>
