---
interface Props {
  platform: 'instagram' | 'facebook' | 'tiktok' | 'pinterest' | 'youtube';
}

const { platform } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  data-social-icon={platform}
  class="size-5 fill-none stroke-current stroke-[1.7]"
>
  {platform === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.4" cy="6.6" r="0.8" class="fill-current stroke-none" />
    </>
  )}
  {platform === 'facebook' && (
    <path d="M13.5 21v-8h3l.5-3h-3.5V8.5c0-1.3.6-2 2-2H18V3.3c-.8-.2-1.8-.3-2.8-.3C12 3 10 5 10 8.3V10H7v3h3v8" />
  )}
  {platform === 'tiktok' && (
    <path d="M14.5 3v12.2a4.7 4.7 0 1 1-4.1-4.7v3.1a1.8 1.8 0 1 0 1.1 1.7V3Zm0 0c.4 2.5 1.9 4.1 4.5 4.5v3.1a7.8 7.8 0 0 1-4.5-1.5" />
  )}
  {platform === 'pinterest' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M9.1 20c.8-2.4 1.3-4.1 1.8-6.5-.5-.8-.7-2-.3-3.2.4-1.4 1.5-2.3 2.7-2 1 .3 1.3 1.5.9 2.9-.4 1.5-1.2 3.6.5 4 1.6.4 2.8-1.7 2.8-4 0-3.3-2.5-5.5-5.8-5.5-3.9 0-6.2 2.9-6.2 5.9 0 1.3.5 2.6 1.5 3.3" />
    </>
  )}
  {platform === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="m10 9 5 3-5 3Z" class="fill-current stroke-none" />
    </>
  )}
</svg>
