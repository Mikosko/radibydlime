---
import { Image } from 'astro:assets';
import MediaImage from '../media-image/MediaImage.astro';
import EditorialLink from '../editorial-link/EditorialLink.astro';
import {
  availabilityLabels,
  type getPublishedSaleItems,
} from '../../content/sale-items/query';
import { summarizePrice, formatPrice } from '../../content/sale-items/pricing';
import type { getMediaCatalog } from '../../content/media/query';
interface Props {
  item: Awaited<ReturnType<typeof getPublishedSaleItems>>[number];
  catalog: Awaited<ReturnType<typeof getMediaCatalog>>;
}
const { item, catalog } = Astro.props;
const { data, cover } = item;
---

<article
  data-sale-card
  class="flex h-full flex-col overflow-hidden rounded-sm border border-line bg-white/25 p-1 lg:overflow-visible lg:border-0 lg:bg-transparent lg:p-0"
>
  <a
    href={`/inzerce/${data.slug}/`}
    aria-label={`Prohlédnout předmět: ${data.title}`}
    class="group relative block overflow-hidden rounded-sm bg-line/20"
  >
    {'width' in cover ? (
      <MediaImage
        mediaId={cover.id}
        {catalog}
        class:list={[
          'aspect-[4/3] w-full group-hover:opacity-90',
          data.imagePresentation === 'cutout'
            ? 'object-contain p-3'
            : 'object-cover',
        ]}
      />
    ) : (
      <Image
        src={cover.src}
        alt={cover.alt}
        loading="lazy"
        widths={[400, 700]}
        sizes="(min-width:1024px) 400px, (min-width:640px) 45vw, 90vw"
        class:list={[
          'aspect-[4/3] w-full group-hover:opacity-90',
          data.imagePresentation === 'cutout'
            ? 'object-contain p-3'
            : 'object-cover',
        ]}
      />
    )}
    <div class="absolute top-3 right-3 left-3 flex flex-wrap items-start justify-between gap-2">
      <span class="rounded-sm bg-paper/95 px-3 py-1.5 text-xs">
        {availabilityLabels[data.availability]}
      </span>
      {summarizePrice(data).discount !== undefined &&
        data.availability === 'available' && (
          <span class="rounded-sm bg-accent px-3 py-1.5 text-xs text-paper">
            {summarizePrice(data).discount}
          </span>
        )}
      {data.unique && (
        <span class="rounded-sm bg-ink/90 px-3 py-1.5 text-xs text-paper">
          Jediný kus
        </span>
      )}
    </div>
  </a>
  <div class="flex flex-1 flex-col px-4 pt-5 pb-4 sm:px-5 sm:pb-5 lg:px-0 lg:pb-0">
    <p class="text-xs tracking-widest text-muted uppercase">{data.category}</p>
    <h3 class="mt-2 font-display text-3xl leading-tight">
      <a href={`/inzerce/${data.slug}/`} class="hover:text-accent">
        {data.title}
      </a>
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-muted">{data.summary}</p>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
      <div>
        <p class="flex flex-wrap items-baseline gap-x-2 font-semibold">
          <span class="text-xl">{summarizePrice(data).text}</span>
          {summarizePrice(data).original !== undefined && (
            <span class="text-sm font-normal text-muted">
              <span class="sr-only">Původní cena: </span>
              <s>{formatPrice(data.priceCzk)}</s>
            </span>
          )}
        </p>
      </div>
      <EditorialLink href={`/inzerce/${data.slug}/`} class="text-sm">
        Detail předmětu
      </EditorialLink>
    </div>
  </div>
</article>
