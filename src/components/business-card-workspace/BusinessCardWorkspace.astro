<script>
  const varnish = document.querySelector<HTMLInputElement>('#varnish-preview');
  if (varnish) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    document
      .querySelectorAll<HTMLElement>('.business-card.front')
      .forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          if (!varnish.checked || reducedMotion.matches) return;
          const bounds = card.getBoundingClientRect();
          const position = Math.max(
            0,
            Math.min(100, ((event.clientX - bounds.left) / bounds.width) * 100),
          );
          card.style.setProperty('--gloss-x', `${position}%`);
        });
        card.addEventListener('pointerleave', () =>
          card.style.removeProperty('--gloss-x'),
        );
      });
  }
  const stage = document.querySelector<HTMLElement>('[data-preview-stage]')!;
  const fullscreen =
    document.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
  fullscreen.hidden = false;
  let previousOverflow = '';
  const updateFullscreen = () => {
    const active =
      document.fullscreenElement === stage ||
      stage.classList.contains('is-expanded');
    fullscreen.setAttribute('aria-pressed', String(active));
    fullscreen.setAttribute(
      'aria-label',
      active ? 'Zavřít celou obrazovku' : 'Celá obrazovka',
    );
    fullscreen.title = active ? 'Zavřít celou obrazovku' : 'Celá obrazovka';
  };
  const closeFallback = () => {
    stage.classList.remove('is-expanded');
    document.documentElement.style.overflow = previousOverflow;
    updateFullscreen();
    fullscreen.focus({ preventScroll: true });
  };
  fullscreen.addEventListener('click', async () => {
    if (document.fullscreenElement === stage) {
      await document.exitFullscreen();
      return;
    }
    if (stage.classList.contains('is-expanded')) {
      closeFallback();
      return;
    }
    try {
      if (!stage.requestFullscreen) throw new Error('Fullscreen unavailable');
      await stage.requestFullscreen();
    } catch {
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      stage.classList.add('is-expanded');
    }
    updateFullscreen();
  });
  document.addEventListener('fullscreenchange', updateFullscreen);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && stage.classList.contains('is-expanded'))
      closeFallback();
  });

  // Fit the physical card to the preview only; print always retains its mm size.
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      if (!entry.contentRect.width) continue;
      const card = entry.target.querySelector<HTMLElement>('.business-card')!;
      card.style.zoom = String(
        Math.min(1.4, entry.contentRect.width / ((96 * 96) / 25.4)),
      );
    }
  });
  document
    .querySelectorAll('.preview-window')
    .forEach((element) => observer.observe(element));
  const button = document.querySelector<HTMLButtonElement>('[data-print]')!;
  const status = document.querySelector<HTMLElement>('[data-print-status]')!;
  button.hidden = false;
  button.addEventListener('click', async () => {
    button.disabled = true;
    status.textContent = 'Připravujeme tisk…';
    try {
      await document.fonts.ready;
      await Promise.all(
        [
          ...document.querySelectorAll<HTMLImageElement>('.business-card img'),
        ].map((image) => image.decode()),
      );
      status.textContent = '';
      window.print();
    } catch {
      status.textContent =
        'Ilustrace se nepodařilo načíst. Obnovte stránku a zkuste tisk znovu.';
    } finally {
      button.disabled = false;
    }
  });
</script>
