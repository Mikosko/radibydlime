---
import '../../styles/global.css';
import { Image } from 'astro:assets';
import bodyFont from '../../assets/fonts/body-400-600.woff2?url';
import displayFont from '../../assets/fonts/display-400.woff2?url';
import botanicalStem from '../../assets/decor/botanical-stem.png';
import footerBorderBotanical from '../../assets/decor/footer-border-botanical.png';
import footerLandscape from '../../assets/decor/footer-landscape.png';
import diyIcon from '../../assets/decor/icon-diy.png';
import gardenIcon from '../../assets/decor/icon-garden.png';
import houseIcon from '../../assets/decor/icon-house.png';
import tornPaper from '../../assets/decor/torn-paper.png';
import BrandMark from '../../components/brand-mark/BrandMark.astro';
import SocialIcon from '../../components/social-icon/SocialIcon.astro';
import TopNavigation from '../../components/top-navigation/TopNavigation.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentYear = new Date().getUTCFullYear();

const footerLinks = [
  { label: 'Úvod', href: '/' },
  { label: 'Náš příběh', href: '#' },
  { label: 'Kapitoly', href: '/kapitoly/' },
  { label: 'Zápisky', href: '#' },
  { label: 'Dílny', href: '#' },
  { label: 'Inzerce', href: '#' },
  { label: 'Kontakt', href: '/kontakt/' },
];

const socialLinks = [
  {
    label: 'Instagram',
    href: '#',
    platform: 'instagram',
    hoverClass:
      'hover:border-[#c13584] hover:bg-[#c13584]/5 hover:text-[#c13584]',
  },
  {
    label: 'Facebook',
    href: '#',
    platform: 'facebook',
    hoverClass:
      'hover:border-[#1877f2] hover:bg-[#1877f2]/5 hover:text-[#1877f2]',
  },
  {
    label: 'TikTok',
    href: '#',
    platform: 'tiktok',
    hoverClass:
      'hover:border-[#fe2c55] hover:bg-[#fe2c55]/5 hover:text-[#fe2c55]',
  },
  {
    label: 'Pinterest',
    href: '#',
    platform: 'pinterest',
    hoverClass:
      'hover:border-[#e60023] hover:bg-[#e60023]/5 hover:text-[#e60023]',
  },
  {
    label: 'YouTube',
    href: '#',
    platform: 'youtube',
    hoverClass:
      'hover:border-[#ff0000] hover:bg-[#ff0000]/5 hover:text-[#ff0000]',
  },
] as const;

const discoveryLinks = [
  {
    title: 'Projekty a stavby',
    description: 'Opravujeme a učíme se',
    href: '/kapitoly/',
    icon: diyIcon,
  },
  {
    title: 'Zahrada a rodina',
    description: 'Pěstujeme v rytmu roku',
    href: '#',
    icon: gardenIcon,
  },
  {
    title: 'Příběhy ze statku',
    description: 'Zapisujeme, co prožíváme',
    href: '#',
    icon: houseIcon,
  },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} | Rádi bydlíme</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#obsah"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-10 focus:bg-paper focus:px-4 focus:py-3 focus:underline"
    >
      Přejít na obsah
    </a>
    <TopNavigation />
    <main
      id="obsah"
      tabindex="-1"
      class="mx-auto w-full max-w-[92rem] flex-1 px-5 sm:px-8"
    >
      <slot />
    </main>
    <slot name="footer-intro">
      <aside
        aria-labelledby="co-u-nas-najdete"
        class="mx-auto mt-20 w-full max-w-[92rem] px-5 sm:mt-24 sm:px-8"
      >
        <div class="grid items-stretch border-y border-line lg:grid-cols-[1.7fr_1.8fr_3fr]">
          <blockquote class="relative isolate m-3 min-h-44 px-7 py-7 pl-35 drop-shadow-sm sm:min-h-48">
            <Image
              src={tornPaper}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class="pointer-events-none absolute inset-0 -z-20 size-full object-fill"
            />
            <Image
              src={botanicalStem}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class="pointer-events-none absolute bottom-1 left-3 -z-10 h-auto w-20 opacity-75 sm:left-5 sm:w-24"
            />
            <p class="font-annotation text-2xl leading-snug sm:text-3xl">
              „Domov není jen místo, ale způsob, jak žít.“
            </p>
          </blockquote>

          <section class="flex flex-col justify-center px-6 py-8 lg:border-l lg:border-line lg:px-9">
            <h2
              id="co-u-nas-najdete"
              class="font-display text-3xl font-semibold leading-tight"
            >
              Co u nás najdete?
            </h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted sm:text-base">
              Od obnovy domu přes práci v dílně až po zahradu a obyčejné rodinné
              dny. Sdílíme zkušenosti, které vznikají při skutečné práci.
            </p>
            <a
              href="/kapitoly/"
              class="mt-5 inline-flex w-fit items-center gap-2 text-xs font-semibold tracking-[0.1em] text-accent uppercase hover:underline"
            >
              Prohlédnout kapitoly <span aria-hidden="true">→</span>
            </a>
          </section>

          <nav
            aria-label="Objevte témata"
            class="grid border-t border-line sm:grid-cols-3 lg:border-t-0 lg:border-l"
          >
            {discoveryLinks.map(({ title, description, href, icon }, index) => (
              <a
                href={href}
                aria-label={
                  href === '#' ? `${title} — stránku připravujeme` : undefined
                }
                class:list={[
                  'group grid min-h-44 grid-rows-[3.5rem_auto_1fr] content-start justify-items-center px-5 py-15 text-center hover:bg-white/25 focus-visible:z-10 sm:min-h-48',
                  index > 0 && 'border-t border-line sm:border-t-0 sm:border-l',
                ]}
              >
                <Image
                  src={icon}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  class="size-14 object-contain opacity-85 transition-transform group-hover:-translate-y-1"
                />
                <span class="mt-3 font-editorial-note text-xs leading-snug tracking-[0.08em] uppercase">
                  {title}
                </span>
                <span class="mt-2 max-w-32 text-xs leading-relaxed text-muted">
                  {description}
                </span>
              </a>
            ))}
          </nav>
        </div>
      </aside>
    </slot>

    <footer class="mt-16 w-full overflow-x-clip" aria-label="Rádi bydlíme">
      <div class="mx-auto w-full max-w-[92rem] px-5 sm:px-8">
        <div class="relative grid gap-10 border-line border-t py-10 sm:grid-cols-2 lg:grid-cols-[1.35fr_0.8fr_0.8fr_1fr] lg:gap-12 lg:py-12">
          <Image
            src={footerBorderBotanical}
            alt=""
            aria-hidden="true"
            width={725}
            loading="lazy"
            class="pointer-events-none absolute opacity-50 top-1.5 right-0 z-10 w-48 -translate-y-[96%] -scale-x-100 sm:w-64 lg:w-80"
          />
          <section aria-labelledby="footer-o-nas">
            <h2 id="footer-o-nas">
              <BrandMark size="large" />
            </h2>
            <p class="mt-3 max-w-sm leading-relaxed text-muted">
              Obnovujeme náš domov, učíme se pracovat vlastníma rukama a
              zapisujeme příběhy, které při tom vznikají.
            </p>
          </section>

          <nav aria-label="Navigace v zápatí">
            <h2 class="font-editorial-note text-xs tracking-[0.14em] uppercase">
              Objevujte
            </h2>
            <ul class="mt-4 space-y-2 text-sm text-muted">
              {footerLinks.slice(0, 4).map(({ label, href }) => (
                <li>
                  <a href={href} class="hover:text-accent hover:underline">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <nav aria-label="Praktické odkazy">
            <h2 class="font-editorial-note text-xs tracking-[0.14em] uppercase">
              U nás
            </h2>
            <ul class="mt-4 space-y-2 text-sm text-muted">
              {footerLinks.slice(4).map(({ label, href }) => (
                <li>
                  <a href={href} class="hover:text-accent hover:underline">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <section aria-labelledby="footer-socialni-site">
            <h2
              id="footer-socialni-site"
              class="font-editorial-note text-xs tracking-[0.14em] uppercase"
            >
              Najdete nás
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              Sledujte každodenní práci, nápady a malé radosti ze statku.
            </p>
            <ul class="mt-5 flex items-center gap-3">
              {socialLinks.map(({ label, href, platform, hoverClass }) => (
                <li>
                  <a
                    href={href}
                    aria-label={`${label} — odkaz připravujeme`}
                    title={`${label} — odkaz připravujeme`}
                    class:list={[
                      'inline-grid size-11 place-items-center rounded-full border border-line bg-paper/50 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                      hoverClass,
                    ]}
                  >
                    <SocialIcon platform={platform} />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>

      <div class="relative left-1/2 -mb-5 w-full min-w-[52rem] max-w-[135.75rem] -translate-x-1/2">
        <Image
          src={footerLandscape}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="block h-auto w-full opacity-65"
        />
        <!-- widths={[832, 1200, 1600, 2172]}
          sizes="(max-width: 832px) 832px, 100vw" -->

        <div class="absolute top-[5%] right-0 left-0 mx-auto w-[24rem] text-center sm:top-[7%] sm:w-[34rem]">
          <BrandMark variant="inline" size="large" class="mx-auto" />
          <span
            class="mx-auto mt-2 block h-px w-20 bg-line sm:mt-3 sm:w-28"
            aria-hidden="true"
          ></span>
          <p class="mt-2 text-[0.48rem] font-semibold tracking-[0.15em] text-muted uppercase sm:mt-3 sm:text-[0.65rem] sm:tracking-[0.2em]">
            dům · dílna · zahrada · rodina
          </p>
          <p class="mt-3 font-annotation text-xl leading-tight text-accent sm:mt-5 sm:text-3xl">
            Krásnější domov
            <br />
            začíná malými kroky.
          </p>
        </div>
      </div>

      <div class="relative mt-5 z-10 mx-auto flex w-full max-w-[82rem] items-center gap-4 px-6 pb-5 sm:gap-7 sm:px-8">
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        <p class="flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
          © {currentYear} Rádi bydlíme
        </p>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
    </footer>
  </body>
</html>
